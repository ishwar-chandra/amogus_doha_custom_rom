+	if (detect_doubletap2wake(gesture->coordinate_x[0], gesture->coordinate_y[0])) {
 		fts_gesture_report(input_dev, gesture->gesture_id);
+		/*
+		 * Nothing else consumes this event on doha: focaltech,report_gesture_key
+		 * is not in the device tree, so fts_gesture_report() only feeds the Moto
+		 * sensor class, and no Moto service or touch HAL is installed to read it.
