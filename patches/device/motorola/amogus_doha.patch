diff --git a/BoardConfig.mk b/BoardConfig.mk
index 9e00b92..fbca65a 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -31,9 +31,49 @@ ifneq ($(TARGET_PREBUILT_KERNEL),)
       $(wildcard device/motorola/amogus-kernel/modules/*.ko)
 endif
 
+# Kernel modules to load at boot, from the source-built kernel.
+# LineageOS's kernel.mk always writes vendor/lib/modules/modules.load
+# (vendor/lineage 01eef7f3), empty when this list is empty.
+# That empty file makes init.modprobe.sh skip its "load everything"
+# fallback and leaves vendor_modprobe.sh with nothing to load, so these
+# never loaded: the aw8695 haptics chip had no driver and the vibrator
+# did not work.
+# The FocalTech and Novatek touch drivers are for doha units without the
+# built-in Himax panel; each only binds when its panel is present.
+BOARD_VENDOR_KERNEL_MODULES_LOAD := \
+    aw8624 \
+    aw8695 \
+    sx933x_sar \
+    stmvl53l1 \
+    focaltech_0flash_mmi \
+    focaltech_0flash_mmi_doha \
+    nova_0flash_mmi
+
+# Touch in recovery (doha_android#49). Recovery has no /vendor, so the
+# FocalTech driver (Tianma FT8719 panel) must be in the ramdisk. Since
+# recovery is the boot ramdisk here, a non-empty modules.load in it would
+# also load the driver in first-stage init on every normal boot, before
+# its firmware is reachable. So the load list stays empty and
+# recovery/root/system/etc/init/touch_doha.rc loads it in recovery only.
+# The Himax driver is built in and only needs its firmware (device.mk).
+RECOVERY_KERNEL_MODULES := focaltech_0flash_mmi_doha.ko
+BOARD_VENDOR_SEPOLICY_DIRS += device/motorola/amogus_doha/sepolicy/recovery
+BOARD_VENDOR_SEPOLICY_DIRS += vendor/motorola-dolby/dolby/sepolicy/vendor
+
+# crDroid: doha has no quick-tap hardware. Without this, crDroid's
+# vendor/lineage/config/crdroid.mk adds the ColumbusService package, which
+# looks for a sensor that isn't there.
+TARGET_SUPPORTS_QUICK_TAP := false
+
 # Partitions
 BOARD_VENDORIMAGE_PARTITION_SIZE := 620756992
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3238002688
+# ext4 system (doha_android#53): with a fixed partition size the build
+# doesn't size the inode table, and mke2fs' default (one per 16 KiB)
+# gives 194688 inodes for about 8100 used. 16384 keeps 2x headroom and
+# frees about 43 MB for GApps and addon.d restores. Too few inodes fails
+# the build ("Out of inodes?"), not the phone.
+BOARD_SYSTEMIMAGE_EXTFS_INODE_COUNT := 16384
 BOARD_DTBOIMG_PARTITION_SIZE := 8388608
 
 # Recovery
diff --git a/device.mk b/device.mk
index 9051022..5d7beb4 100644
--- a/device.mk
+++ b/device.mk
@@ -27,7 +27,8 @@ TARGET_USES_FINGERPRINT_V2_1 := true
 # Overlays
 PRODUCT_PACKAGES += \
     dohaFrameworkOverlay \
-    dohaSystemUIOverlay
+    dohaSystemUIOverlay \
+    dohaApertureOverlay
 
 # Partitions
 TARGET_USES_DYNAMIC_PARTITIONS := false
@@ -44,4 +45,75 @@ PRODUCT_BUILD_PROP_OVERRIDES += \
     BuildDesc="doha_retail-user 10 QPIS30.28-Q3-28-26-4-1-3 f0a9a release-keys" \
     BuildFingerprint=motorola/doha_retail/doha:10/QPIS30.28-Q3-28-26-4-1-3/f0a9a:user/release-keys
 
+# Touch firmware for recovery (doha_android#49). Both doha touch
+# controllers have no flash and get their firmware from the host, but
+# recovery doesn't mount /vendor, and amogus' device-recovery.mk only
+# covers rav and sofia. Tianma FT8719 (FocalTech) and DS HX83112A (Himax).
+PRODUCT_COPY_FILES += \
+    vendor/motorola/amogus_doha/proprietary/vendor/firmware/focaltech-ft8719-a0-0000-doha.bin:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/firmware/focaltech-ft8719-a0-0000-doha.bin \
+    vendor/motorola/amogus_doha/proprietary/vendor/firmware/ds_Himax_firmware.bin:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/firmware/ds_Himax_firmware.bin
+
+# LineageOS 24.0's build no longer copies <device>/recovery/root into
+# recovery (23.2 had that as a build/make patch), so install the init
+# script that loads the FocalTech module explicitly.
+PRODUCT_COPY_FILES += \
+    device/motorola/amogus_doha/recovery/root/system/etc/init/touch_doha.rc:$(TARGET_COPY_OUT_RECOVERY)/root/system/etc/init/touch_doha.rc
+
 $(call inherit-product-if-exists, vendor/motorola/amogus_doha/amogus_doha-vendor.mk)
+
+# Dolby Atmos from vendor/motorola-dolby (userariii v1.2, DAX3 3.6).
+# The stock doha 10 stack is gone: its libswdap (2019) rejects every DAP
+# parameter under Android 17's audioserver (getNumOfProfiles -> EINVAL), so
+# Moto Audio's provider query could never work. This stack is built for
+# Android 13+, uses vendor.dolby.hardware.dms@2.0 instead of 1.0, and its
+# DaxUI/daxService are re-signed with the platform key, so daxService holds
+# INTERACT_ACROSS_USERS_FULL by signature (no framework change needed).
+DOLBY_PATH := vendor/motorola-dolby/dolby
+
+PRODUCT_SOONG_NAMESPACES += $(DOLBY_PATH)
+PRODUCT_PACKAGES += DaxUI daxService
+
+AUDIO_FEATURE_ENABLED_DS2_DOLBY_DAP := true
+TARGET_EXCLUDES_AUDIOFX := true
+
+# The donor's manifest fragment declares target-level="5" (Android 13); a
+# fragment with a stale level fails the VINTF check on Android 17, so
+# dolby/manifest.xml repeats the HAL entry without it.
+DEVICE_MANIFEST_FILE += device/motorola/amogus_doha/dolby/manifest.xml
+DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE += $(DOLBY_PATH)/hidl/framework_compatibility_matrix.xml
+
+# libdlbdsservice links the v33 VNDK stage (it was built against
+# libstagefright_foundation-v33); lineage-24.0 still ships prebuilts/vndk/v33.
+PRODUCT_COPY_FILES += \
+    prebuilts/vndk/v33/arm/arch-arm-armv7-a-neon/shared/vndk-core/libstagefright_foundation.so:$(TARGET_COPY_OUT_VENDOR)/lib/libstagefright_foundation-v33.so \
+    prebuilts/vndk/v33/arm64/arch-arm64-armv8-a/shared/vndk-core/libstagefright_foundation.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libstagefright_foundation-v33.so
+
+# Audio-only subset: the DaxUI/daxService apps, the dms@2.0 HAL, the DAP
+# effect and its param store. The donor's AC4/DD+ codec libs and the
+# dms360 ODM service are not carried; Dolby codec decoding is separate.
+PRODUCT_COPY_FILES += \
+    $(DOLBY_PATH)/proprietary/system_ext/etc/permissions/privapp-com.dolby.daxappui.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/permissions/privapp-com.dolby.daxappui.xml \
+    $(DOLBY_PATH)/proprietary/system_ext/etc/permissions/privapp-com.dolby.daxservice.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/permissions/privapp-com.dolby.daxservice.xml \
+    $(DOLBY_PATH)/proprietary/system_ext/etc/sysconfig/config-com.dolby.daxappui.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/sysconfig/config-com.dolby.daxappui.xml \
+    $(DOLBY_PATH)/proprietary/system_ext/etc/sysconfig/config-com.dolby.daxservice.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/sysconfig/config-com.dolby.daxservice.xml \
+    $(DOLBY_PATH)/proprietary/system_ext/etc/sysconfig/hiddenapi-com.dolby.daxservice.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/sysconfig/hiddenapi-com.dolby.daxservice.xml \
+    $(DOLBY_PATH)/proprietary/vendor/bin/hw/vendor.dolby.hardware.dms@2.0-service:$(TARGET_COPY_OUT_VENDOR)/bin/hw/vendor.dolby.hardware.dms@2.0-service \
+    $(DOLBY_PATH)/proprietary/vendor/etc/dolby/dax-default.xml:$(TARGET_COPY_OUT_VENDOR)/etc/dolby/dax-default.xml \
+    $(DOLBY_PATH)/proprietary/vendor/etc/init/vendor.dolby.hardware.dms@2.0-service.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/vendor.dolby.hardware.dms@2.0-service.rc \
+    $(DOLBY_PATH)/proprietary/vendor/lib/libdapparamstorage.so:$(TARGET_COPY_OUT_VENDOR)/lib/libdapparamstorage.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib/soundfx/libswdap.so:$(TARGET_COPY_OUT_VENDOR)/lib/soundfx/libswdap.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib/soundfx/libswgamedap.so:$(TARGET_COPY_OUT_VENDOR)/lib/soundfx/libswgamedap.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib/soundfx/libswvqe.so:$(TARGET_COPY_OUT_VENDOR)/lib/soundfx/libswvqe.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib/vendor.dolby.hardware.dms@2.0.so:$(TARGET_COPY_OUT_VENDOR)/lib/vendor.dolby.hardware.dms@2.0.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/libdapparamstorage.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libdapparamstorage.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/libdlbdsservice.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libdlbdsservice.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/soundfx/libswdap.so:$(TARGET_COPY_OUT_VENDOR)/lib64/soundfx/libswdap.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/soundfx/libswgamedap.so:$(TARGET_COPY_OUT_VENDOR)/lib64/soundfx/libswgamedap.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/soundfx/libswvqe.so:$(TARGET_COPY_OUT_VENDOR)/lib64/soundfx/libswvqe.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/vendor.dolby.hardware.dms@2.0-impl.so:$(TARGET_COPY_OUT_VENDOR)/lib64/vendor.dolby.hardware.dms@2.0-impl.so \
+    $(DOLBY_PATH)/proprietary/vendor/lib64/vendor.dolby.hardware.dms@2.0.so:$(TARGET_COPY_OUT_VENDOR)/lib64/vendor.dolby.hardware.dms@2.0.so
+
+PRODUCT_PRODUCT_PROPERTIES += \
+    persist.vendor.audio_fx.current=dolby \
+    ro.vendor.audio.dolby.dax.support=true \
+    ro.vendor.dolby.dax.version=DAX3_3.6.0.12_r1
diff --git a/recovery/root/system/etc/init/touch_doha.rc b/recovery/root/system/etc/init/touch_doha.rc
new file mode 100644
index 0000000..b8642da
--- /dev/null
+++ b/recovery/root/system/etc/init/touch_doha.rc
@@ -0,0 +1,19 @@
+# Recovery only (doha_android#49): touch for units with the Tianma
+# FT8719 panel (FocalTech). Normal boot never reads this file.
+#
+# The driver is a module, and the controller has no flash: it needs its
+# firmware pushed by the host. The driver only learns the firmware file
+# name when something writes it to doreflash; in Android that's
+# /vendor/bin/init.mmi.touch.sh, which recovery doesn't have. doha has
+# one FocalTech panel and one firmware file for it, in recovery's
+# /vendor/firmware (device.mk).
+# The driver drops the last character of what's written (it expects the
+# newline echo adds), hence the \n.
+#
+# On units with the Himax panel the FocalTech device tree node is
+# disabled, so the module doesn't bind, and the Himax driver (built in)
+# has no doreflash: the write just fails.
+on init
+    exec u:r:modprobe:s0 -- /system/bin/modprobe -a -d /lib/modules focaltech_0flash_mmi_doha
+    wait /sys/devices/platform/soc/4a88000.spi/spi_master/spi0/spi0.0/doreflash 2
+    write /sys/devices/platform/soc/4a88000.spi/spi_master/spi0/spi0.0/doreflash focaltech-ft8719-a0-0000-doha.bin\n
