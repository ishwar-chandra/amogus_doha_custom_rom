diff --git a/BoardConfig.mk b/BoardConfig.mk
index 9e00b92..fbca65a 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -31,9 +31,49 @@ ifneq ($(TARGET_PREBUILT_KERNEL),)
       $(wildcard device/motorola/amogus-kernel/modules/*.ko)
 endif
 
+# Kernel modules to load at boot, from the source-built kernel.
+# LineageOS's kernel.mk always writes vendor/lib/modules/modules.load
+# (vendor/lineage 01eef7f3), empty when this list is empty.
+# That empty file makes init.modprobe.sh skip its "load everything"
+# fallback and leaves vendor_modprobe.sh with nothing to load, so these
+# never loaded: the aw8695 haptics chip had no driver and the vibrator
+# did not work.
+# The FocalTech and Novatek touch drivers are for doha units without the
+# built-in Himax panel; each only binds when its panel is present.
+BOARD_VENDOR_KERNEL_MODULES_LOAD := \
+    aw8624 \
+    aw8695 \
+    sx933x_sar \
+    stmvl53l1 \
+    focaltech_0flash_mmi \
+    focaltech_0flash_mmi_doha \
+    nova_0flash_mmi
+
+# Touch in recovery (doha_android#49). Recovery has no /vendor, so the
+# FocalTech driver (Tianma FT8719 panel) must be in the ramdisk. Since
+# recovery is the boot ramdisk here, a non-empty modules.load in it would
+# also load the driver in first-stage init on every normal boot, before
+# its firmware is reachable. So the load list stays empty and
+# recovery/root/system/etc/init/touch_doha.rc loads it in recovery only.
+# The Himax driver is built in and only needs its firmware (device.mk).
+RECOVERY_KERNEL_MODULES := focaltech_0flash_mmi_doha.ko
+BOARD_VENDOR_SEPOLICY_DIRS += device/motorola/amogus_doha/sepolicy/recovery
+BOARD_VENDOR_SEPOLICY_DIRS += device/motorola/amogus_doha/sepolicy/vendor
+
+# crDroid: doha has no quick-tap hardware. Without this, crDroid's
+# vendor/lineage/config/crdroid.mk adds the ColumbusService package, which
+# looks for a sensor that isn't there.
+TARGET_SUPPORTS_QUICK_TAP := false
+
 # Partitions
 BOARD_VENDORIMAGE_PARTITION_SIZE := 620756992
 BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3238002688
+# ext4 system (doha_android#53): with a fixed partition size the build
+# doesn't size the inode table, and mke2fs' default (one per 16 KiB)
+# gives 194688 inodes for about 8100 used. 16384 keeps 2x headroom and
+# frees about 43 MB for GApps and addon.d restores. Too few inodes fails
+# the build ("Out of inodes?"), not the phone.
+BOARD_SYSTEMIMAGE_EXTFS_INODE_COUNT := 16384
 BOARD_DTBOIMG_PARTITION_SIZE := 8388608
 
 # Recovery
diff --git a/device.mk b/device.mk
index 9051022..5d7beb4 100644
--- a/device.mk
+++ b/device.mk
@@ -27,7 +27,8 @@ TARGET_USES_FINGERPRINT_V2_1 := true
 # Overlays
 PRODUCT_PACKAGES += \
     dohaFrameworkOverlay \
-    dohaSystemUIOverlay
+    dohaSystemUIOverlay \
+    dohaApertureOverlay
 
 # Partitions
 TARGET_USES_DYNAMIC_PARTITIONS := false
@@ -44,4 +45,55 @@ PRODUCT_BUILD_PROP_OVERRIDES += \
     BuildDesc="doha_retail-user 10 QPIS30.28-Q3-28-26-4-1-3 f0a9a release-keys" \
     BuildFingerprint=motorola/doha_retail/doha:10/QPIS30.28-Q3-28-26-4-1-3/f0a9a:user/release-keys
 
+# Touch firmware for recovery (doha_android#49). Both doha touch
+# controllers have no flash and get their firmware from the host, but
+# recovery doesn't mount /vendor, and amogus' device-recovery.mk only
+# covers rav and sofia. Tianma FT8719 (FocalTech) and DS HX83112A (Himax).
+PRODUCT_COPY_FILES += \
+    vendor/motorola/amogus_doha/proprietary/vendor/firmware/focaltech-ft8719-a0-0000-doha.bin:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/firmware/focaltech-ft8719-a0-0000-doha.bin \
+    vendor/motorola/amogus_doha/proprietary/vendor/firmware/ds_Himax_firmware.bin:$(TARGET_COPY_OUT_RECOVERY)/root/vendor/firmware/ds_Himax_firmware.bin
+
+# LineageOS 24.0's build no longer copies <device>/recovery/root into
+# recovery (23.2 had that as a build/make patch), so install the init
+# script that loads the FocalTech module explicitly.
+PRODUCT_COPY_FILES += \
+    device/motorola/amogus_doha/recovery/root/system/etc/init/touch_doha.rc:$(TARGET_COPY_OUT_RECOVERY)/root/system/etc/init/touch_doha.rc
+
 $(call inherit-product-if-exists, vendor/motorola/amogus_doha/amogus_doha-vendor.mk)
+
+# Dolby Atmos from the stock doha 10 firmware (QPIS30.28):
+#   system/app/MotoDolbyV3          Moto Audio UI (com.motorola.dolby.dolbyui)
+#   system/priv-app/daxService      com.dolby.daxservice, the DMS client
+#   vendor DMS HIDL 1.0 + libswdap  the DAP effect used by audioserver
+# The stock vendor binaries are not in vendor/motorola/amogus, so they are
+# carried here and copied into /vendor. See sepolicy/vendor/dolby.te.
+DOLBY_PATH := device/motorola/amogus_doha/dolby
+
+PRODUCT_COPY_FILES += \
+    $(DOLBY_PATH)/system/etc/permissions/com.dolby.daxservice.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/com.dolby.daxservice.xml \
+    $(DOLBY_PATH)/system/etc/permissions/com.motorola.dolby.dolbyui.features.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/com.motorola.dolby.dolbyui.features.xml \
+    $(DOLBY_PATH)/system/etc/permissions/com.motorola.frameworks.core.addon.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/com.motorola.frameworks.core.addon.xml \
+    $(DOLBY_PATH)/system/etc/permissions/com.motorola.motosignature.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/com.motorola.motosignature.xml \
+    $(DOLBY_PATH)/system/etc/permissions/com.motorola.android.settings.shared.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/com.motorola.android.settings.shared.xml \
+    $(DOLBY_PATH)/system/etc/sysconfig/hiddenapi-whitelist-com.motorola.dolby.dolbyui.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/sysconfig/hiddenapi-whitelist-com.motorola.dolby.dolbyui.xml \
+    $(DOLBY_PATH)/system/framework/com.motorola.frameworks.core.addon.jar:$(TARGET_COPY_OUT_SYSTEM)/framework/com.motorola.frameworks.core.addon.jar \
+    $(DOLBY_PATH)/system/framework/com.motorola.motosignature.jar:$(TARGET_COPY_OUT_SYSTEM)/framework/com.motorola.motosignature.jar \
+    $(DOLBY_PATH)/system/framework/com.motorola.android.settings.shared.jar:$(TARGET_COPY_OUT_SYSTEM)/framework/com.motorola.android.settings.shared.jar \
+    $(DOLBY_PATH)/vendor/lib/soundfx/libswdap.so:$(TARGET_COPY_OUT_VENDOR)/lib/soundfx/libswdap.so \
+    $(DOLBY_PATH)/vendor/lib64/soundfx/libswdap.so:$(TARGET_COPY_OUT_VENDOR)/lib64/soundfx/libswdap.so \
+    $(DOLBY_PATH)/vendor/lib/libdapparamstorage.so:$(TARGET_COPY_OUT_VENDOR)/lib/libdapparamstorage.so \
+    $(DOLBY_PATH)/vendor/lib64/libdapparamstorage.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libdapparamstorage.so \
+    $(DOLBY_PATH)/vendor/lib/vendor.dolby.hardware.dms@1.0.so:$(TARGET_COPY_OUT_VENDOR)/lib/vendor.dolby.hardware.dms@1.0.so \
+    $(DOLBY_PATH)/vendor/lib64/vendor.dolby.hardware.dms@1.0.so:$(TARGET_COPY_OUT_VENDOR)/lib64/vendor.dolby.hardware.dms@1.0.so \
+    $(DOLBY_PATH)/vendor/lib64/vendor.dolby.hardware.dms@1.0-impl.so:$(TARGET_COPY_OUT_VENDOR)/lib64/vendor.dolby.hardware.dms@1.0-impl.so \
+    $(DOLBY_PATH)/vendor/lib64/libdlbdsservice.so:$(TARGET_COPY_OUT_VENDOR)/lib64/libdlbdsservice.so \
+    $(DOLBY_PATH)/vendor/etc/init/vendor.dolby.hardware.dms@1.0-service.rc:$(TARGET_COPY_OUT_VENDOR)/etc/init/vendor.dolby.hardware.dms@1.0-service.rc \
+    $(DOLBY_PATH)/vendor/etc/dolby/dax-default.xml:$(TARGET_COPY_OUT_VENDOR)/etc/dolby/dax-default.xml
+
+PRODUCT_PACKAGES += \
+    MotoDolbyV3 \
+    daxService \
+    vendor.dolby.hardware.dms@1.0-service
+PRODUCT_VENDOR_PROPERTIES += persist.vendor.audio_fx.current=dolby
+DEVICE_MANIFEST_FILE += $(DOLBY_PATH)/vendor/etc/vintf/manifest/dolby.xml
+DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE += $(DOLBY_PATH)/vendor/etc/vintf/compatibility_matrix.dolby.xml
diff --git a/dolby/Android.mk b/dolby/Android.mk
new file mode 100644
index 0000000..f1d77b3
--- /dev/null
+++ b/dolby/Android.mk
@@ -0,0 +1,41 @@
+LOCAL_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := MotoDolbyV3
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_DEX_PREOPT := false
+# MotoDolbyV3.apk's manifest requires com.motorola.frameworks.core.addon.
+# The jar and its <library> permission XML are copied by device.mk, so it
+# resolves at runtime, but the addon is not a JAVA_LIBRARIES module here, so
+# declaring LOCAL_USES_LIBRARIES would add a dexpreopt dependency on a
+# config that does not exist. The APK is a presigned Moto blob we cannot
+# retag and is not dexpreopted, so skip the coherence check for it.
+LOCAL_ENFORCE_USES_LIBRARIES := false
+LOCAL_SRC_FILES := system/app/MotoDolbyV3/MotoDolbyV3.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := daxService
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_PRIVILEGED_MODULE := true
+LOCAL_DEX_PREOPT := false
+LOCAL_SRC_FILES := system/priv-app/daxService/daxService.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := vendor.dolby.hardware.dms@1.0-service
+LOCAL_MODULE_CLASS := EXECUTABLES
+LOCAL_MODULE_PATH := $(TARGET_OUT_VENDOR)/bin/hw
+LOCAL_SRC_FILES := vendor/bin/hw/vendor.dolby.hardware.dms@1.0-service
+LOCAL_MODULE_TAGS := optional
+# The stock binary's DT_NEEDED libs are copied blobs (libdapparamstorage,
+# libdlbdsservice, vendor.dolby.hardware.dms@1.0*), not build modules, so
+# Android 17's check_elf_files cannot be satisfied for this prebuilt.
+LOCAL_CHECK_ELF_FILES := false
+include $(BUILD_PREBUILT)
