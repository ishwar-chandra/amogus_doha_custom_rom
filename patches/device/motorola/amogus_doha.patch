diff --git a/dolby/Android.bp b/dolby/Android.bp
new file mode 100644
index 0000000..8a22d4b
--- /dev/null
+++ b/dolby/Android.bp
@@ -0,0 +1,20 @@
+// DaxUI with the in-app power button fixed.
+//
+// The vendor APK's MainActivity.dsPowerChanged() installs a full-screen
+// poweroffLayout and disables the controls while Dolby is off, so the app's
+// own power button cannot turn it on - only the Quick Settings tile can.
+// DaxUI.apk here is the vendor APK with one instruction changed: the
+// `if-eqz v13, +0x122` at dex offset 0x16ac72 (the branch into the off
+// state) is replaced by two nops, so the interactive UI is always shown and
+// the power button toggles Dolby both ways. android_app_import re-signs the
+// APK with the platform key, as the vendor module did.
+android_app_import {
+    name: "DaxUI-patched",
+    apk: "DaxUI.apk",
+    certificate: "platform",
+    privileged: true,
+    system_ext_specific: true,
+    dex_preopt: {
+        enabled: false,
+    },
+}
