diff --git a/sepolicy/recovery/init.te b/sepolicy/recovery/init.te
new file mode 100644
index 0000000..8971ac0
--- /dev/null
+++ b/sepolicy/recovery/init.te
@@ -0,0 +1,6 @@
+# Recovery only (doha_android#49): recovery/root/system/etc/init/touch_doha.rc
+# writes the FocalTech touch firmware name to the driver's doreflash node.
+# In Android, init.mmi.touch.sh (vendor_moto_init_shell) does this.
+recovery_only(`
+  allow init vendor_sysfs_touchpanel:file w_file_perms;
+')
diff --git a/sepolicy/vendor/dolby.te b/sepolicy/vendor/dolby.te
new file mode 100644
index 0000000..238c2fc
--- /dev/null
+++ b/sepolicy/vendor/dolby.te
@@ -0,0 +1,28 @@
+# Dolby Media Service (DMS) HIDL HAL and the DAP effect client.
+# The stock doha vendor policy has the same types; this is the source form.
+type hal_dms_default, domain;
+hal_attribute(dms)
+hal_server_domain(hal_dms_default, hal_dms)
+
+# audioserver loads /vendor/lib64/soundfx/libswdap.so, which talks to DMS.
+hal_client_domain(audioserver, hal_dms)
+# com.dolby.daxservice is a privileged app and is the DMS client.
+hal_client_domain(priv_app, hal_dms)
+
+type hal_dms_default_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(hal_dms_default)
+
+type hal_dms_hwservice, hwservice_manager_type;
+allow hal_dms_default hal_dms_hwservice:hwservice_manager { add find };
+
+type vendor_dolby_loglevel_prop, property_type;
+allow { init vendor_init hal_dms_default priv_app } vendor_dolby_loglevel_prop:property_service set;
+
+# /data/vendor/dolby stores the DAP parameter database; the stock image
+# leaves it at the default /data/vendor label (vendor_data_file).
+allow hal_dms_default vendor_data_file:dir create_dir_perms;
+allow hal_dms_default vendor_data_file:file create_file_perms;
+allow hal_dms_default vendor_configs_file:file r_file_perms;
+allow hal_dms_default audio_device:chr_file rw_file_perms;
+allow hal_dms_default vendor_file:file { read open execute getattr map };
+allow hal_dms_default vendor_file:dir search;
