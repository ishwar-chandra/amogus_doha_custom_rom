diff --git a/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt b/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt
index e4f7355..dd47c93 100644
--- a/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt
+++ b/app/src/main/java/org/lineageos/updater/data/UpdatesRepository.kt
@@ -132,6 +132,15 @@ class UpdatesRepository(
             Log.d(TAG, "${update.name} is older than current Android version")
             return false
         }
+
+        // build.sh renders @UPDATER_CHANNEL@ here. Both channels are signed
+        // with the same testkey, so this is the only thing that stops a
+        // standard build from installing a debloat zip (and vice versa).
+        val channelIsDebloat = "@UPDATER_CHANNEL@" == "debloat"
+        if (update.name.contains("-debloat") != channelIsDebloat) {
+            Log.d(TAG, "${update.name} is from the other channel")
+            return false
+        }
         return true
     }
 }
