+package com.crdroid.settings.utils;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceGroup;
+import androidx.preference.PreferenceScreen;
+
+/**
+ * Hides preferences that launch an app that is not installed.
+ *
+ * crDroid Settings carries entries for optional packages (Gaming mode,
+ * Sidebar, OmniJaws weather). A debloat build removes those packages from
+ * PRODUCT_PACKAGES, but the preference XML is shared, so the entries stayed
+ * visible and tapping them did nothing. Hiding them here keeps one XML for
+ * both variants instead of gating the resources at build time.
+ */
+public final class PreferenceAvailability {
+
+    private PreferenceAvailability() {
+    }
+
+    /** Call after addPreferencesFromResource() so the tree is inflated. */
+    public static void hideEntriesForMissingPackages(PreferenceScreen screen, Context context) {
+        if (screen == null || context == null) {
+            return;
+        }
+        prune(screen, context);
+        pruneEmptyGroups(screen, context);
+    }
+
+    private static void prune(PreferenceGroup group, Context context) {
+        for (int i = group.getPreferenceCount() - 1; i >= 0; i--) {
+            Preference preference = group.getPreference(i);
+            Intent intent = preference.getIntent();
+            if (intent != null && !isTargetInstalled(intent, context)) {
+                preference.setVisible(false);
+            }
+            if (preference instanceof PreferenceGroup) {
+                prune((PreferenceGroup) preference, context);
+            }
+        }
+    }
+
+    /** A category whose children are all invisible is hidden as well. */
+    private static void pruneEmptyGroups(PreferenceGroup group, Context context) {
+        for (int i = group.getPreferenceCount() - 1; i >= 0; i--) {
+            Preference preference = group.getPreference(i);
+            if (!(preference instanceof PreferenceGroup) || preference instanceof PreferenceScreen) {
+                continue;
+            }
+            PreferenceGroup child = (PreferenceGroup) preference;
+            pruneEmptyGroups(child, context);
+            if (child.getPreferenceCount() == 0) {
+                continue;
+            }
+            boolean anyVisible = false;
+            for (int j = 0; j < child.getPreferenceCount(); j++) {
+                if (child.getPreference(j).isVisible()) {
+                    anyVisible = true;
+                    break;
+                }
+            }
+            if (!anyVisible) {
+                child.setVisible(false);
+            }
+        }
+    }
+
+    private static boolean isTargetInstalled(Intent intent, Context context) {
+        ComponentName component = intent.getComponent();
+        if (component == null || component.getPackageName() == null) {
+            // Action-only intents resolve to something else; leave them alone.
+            return true;
+        }
+        try {
+            context.getPackageManager().getPackageInfo(component.getPackageName(), 0);
+            return true;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+}
