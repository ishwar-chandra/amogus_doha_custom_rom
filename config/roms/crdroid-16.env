# ROM definition: crDroid 12.x / Android 16.
# crDroid 12.13 (Android 16) tracks LineageOS 23.2 (AOSP android-16.0.0_r4).

# Display label only; the real CR_VERSION comes from vendor/lineage/config/version.mk.
ROM_NAME="crDroid 12.13 (Android 16)"
ANDROID_VERSION=16
MANIFEST_URL=https://github.com/crdroidandroid/android.git
MANIFEST_BRANCH=16.0

# crDroid 16 still checks its vendor fork out at vendor/lineage.
VENDOR_DIR=vendor/lineage
PRODUCT_PREFIX=lineage

# AOSP release name used by lunch; read from vendor/lineage/vars at build time
# when available.
LUNCH_RELEASE=bp4a
