# Device definition: Motorola Moto G8 Plus.
DEVICE=amogus_doha
DEVICE_NAME="Motorola Moto G8 Plus"
SOC=sm6125
ARCH=arm64
KERNEL_SLOT=kernel/motorola/msm-4.14
KERNEL_CONFIG=vendor/amogus_doha_defconfig

# Partition facts verified from the device tree (do not "fix" these):
#   A/B, non-dynamic, system+vendor are separate read-only erofs partitions.
#   system = 3238002688 bytes, vendor = 620756992 bytes.
#   recovery lives inside boot (BOARD_USES_RECOVERY_AS_BOOT).
