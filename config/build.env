# Build-wide settings. Sourced by scripts/lib.sh; plain shell, no arrays.

# Which ROM definition under config/roms/ to build.
ROM=crdroid-16

# Which device definition under config/device.env to build.
DEVICE=amogus_doha

# userdebug = test/phablet builds, user = release. Release also needs signing.
BUILD_VARIANT=userdebug

# Parallelism. Empty = nproc.
JOBS=

# repo sync parallelism. Keep low: android.googlesource.com rate-limits.
SYNC_JOBS=4

# Compiler cache. Empty = work/ccache.
CCACHE_DIR=
CCACHE_MAXSIZE=50G

# Bake MindTheGapps into the image. MUST stay true on this device:
# the system partition is read-only erofs; add-on GApps zips cannot install.
BUNDLE_GAPPS=true
GAPPS_BRANCH=baklava

# test or release. "release" requires vendor/lineage-priv/keys to exist
# (see docs/PLAY_INTEGRITY.md). Test keys do not pass Play Integrity reliably.
SIGNING=test

# Where the Android tree lives. Empty = <repo>/work/android.
ANDROID_SRC=

# Where finished artifacts are collected. Empty = <repo>/dist.
DIST_DIR=

# Set to 1 to let ./scripts/build.sh deps run apt-get (needs sudo).
INSTALL_DEPS=0
